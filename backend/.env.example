# Only needed for the prod profile. `mvn spring-boot:run` with no env uses an in-memory H2 database.
SPRING_PROFILES_ACTIVE=prod

# Either a libpq connection string (what Neon shows you)...
DATABASE_URL=postgresql://USER:PASSWORD@ep-example-123456.us-east-2.aws.neon.tech/taleforge?sslmode=require
# ...or explicit JDBC settings, which take precedence:
# DB_URL=jdbc:postgresql://ep-example-123456.us-east-2.aws.neon.tech/taleforge?sslmode=require
# DB_USERNAME=USER
# DB_PASSWORD=PASSWORD

# At least 32 characters. Generate one with: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRATION_HOURS=168

# Comma-separated; wildcards allowed.
CORS_ALLOWED_ORIGINS=https://tale-forge.vercel.app,https://*.vercel.app,http://localhost:3000
